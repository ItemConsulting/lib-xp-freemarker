{
  "name": "@item-enonic-types/lib-freemarker",
  "sideEffects": false,
  "description": "Type definitions for lib-freemarker",
  "author": "Tom Arild Jakobsen <tajakobsen@gmail.com>",
  "version": "3.0.0",
  "license": "MIT",
  "types": "dist/freemarker.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItemConsulting/lib-xp-freemarker.git"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@enonic-types/global": "^7.15.4",
    "@swc/core": "^1.13.5",
    "@types/node": "^24.3.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "dependencies": {
    "@enonic-types/core": "*"
  },
  "bugs": {
    "url": "https://github.com/ItemConsulting/lib-xp-freemarker/issues"
  },
  "homepage": "https://github.com/ItemConsulting/lib-xp-freemarker#readme",
  "private": false,
  "scripts": {
    "build": "node tsup/anyServerFiles.js && npx tsup -d build/resources/main",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "node tsup/anyServerFiles.js && npx tsc --noEmit -p src/main/resources/tsconfig.json",
    "lint": "eslint --cache \"src/main/resources/**/*.ts\"",
    "release": "npm run build",
    "versioning": "npx changeset version && npm i --package-lock-only && NEW_VERSION=$(node -p \"require('./package.json').version\") && sed -i \"s/version.*/version = ${NEW_VERSION}/\" gradle.properties",
    "prepublishOnly": "tsc --project src/main/resources/tsconfig.json --declarationDir dist --emitDeclarationOnly true --declaration true",
    "postpublish": "rm -r ./dist"
  }
}
